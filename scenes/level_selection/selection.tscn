[sub_resource type="GDScript" id="GDScript_ns00s"]
script/source = "extends Control

@onready var grid = $MarginContainer/VBoxContainer/GridContainer

func _ready():
	var dir := DirAccess.open(global.levels_path)
	if dir == null:
		push_error(\"Levels folder not found!\")
		return
	
	for file_name in dir.get_files():
		if file_name.ends_with(\".tres\"):	
			var button := Button.new()
			button.text = file_name.get_basename()
			button.custom_minimum_size = Vector2(80, 80)
			button.focus_mode = Control.FOCUS_NONE
			button.connect(\"pressed\", Callable(self, \"_on_level_selected\").bind(file_name))
			grid.add_child(button)

func _on_level_selected(file_name: String):
	global.current_level_path = global.levels_path + file_name
	global.level = null
	global.level = load(global.current_level_path) as LevelData
	if not global.level:
		push_error(\"Failed to load level: \" + global.current_level_path)
		return
	get_tree().change_scene_to_file(global.level_scene_path)

func _on_button_pressed() -> void:
	get_tree().change_scene_to_file(global.main_menu_scene_path)
"

[sub_resource type="Shader" id="Shader_fu7sn"]
code = "shader_type canvas_item;

uniform float blur_size : hint_range(0.0, 8.0) = 9.0;

void fragment() {
    // Convert integer texture size to vec2(float)
    vec2 tex_size = vec2(textureSize(TEXTURE, 0));
    vec2 pixel = 1.0 / tex_size;

    vec4 col = vec4(0.0);
    float total = 0.0;

    // Sample in a 9-tap blur pattern
    for (float x = -4.0; x <= 4.0; x++) {
        for (float y = -4.0; y <= 4.0; y++) {
            float weight = exp(-(x*x + y*y) / (2.0 * blur_size * blur_size));
            col += texture(TEXTURE, UV + vec2(x, y) * pixel) * weight;
            total += weight;
        }
    }

    col /= total;   // normalize
    COLOR = col;
}"

